# VaultKey deployment settings.
# Copy this file to .env (same directory as docker-compose.yml) and fill in values.
# .env is gitignored; never commit it.

# REQUIRED. Audit-log HMAC signing key. Generate one with:
#   openssl rand -hex 32
# In production the server refuses to boot if this equals any shipped default.
VAULTKEY_HMAC_KEY=

# Public domain Caddy should serve, e.g. vaultkey.example.com.
# Automatically added to CORS allowed origins (as https://$VAULTKEY_DOMAIN).
# Leave unset for local development (falls back to localhost with internal TLS).
VAULTKEY_DOMAIN=

# REQUIRED for production sign-up and login. Create a Cloudflare Turnstile
# widget for VAULTKEY_DOMAIN and use its site key and secret key here.
VAULTKEY_TURNSTILE_SITE_KEY=
VAULTKEY_TURNSTILE_SECRET_KEY=

# Optional. Additional comma-separated CORS allowed origins (e.g. preview apps, custom portals).
# VAULTKEY_ALLOWED_ORIGINS=

# Optional ACME account email for Let's Encrypt notifications.
# Referenced by the commented global options block in the Caddyfile.
ACME_EMAIL=

# REQUIRED in production. Use Brevo or complete SMTP credentials; the console
# provider logs OTP codes and is rejected in production.
# Brevo Transactional Email (Free REST API - 300 emails/day)
# Get your API key from: https://app.brevo.com/settings/keys/api
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Use an address verified by your email provider.
EMAIL_FROM=
EMAIL_FROM_NAME="VaultKey Support"
# To use SMTP instead, set EMAIL_PROVIDER=smtp and configure all four fields:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional recurring billing. Leave all five values blank to disable checkout.
# If enabled, create the plans in Razorpay and set their real plan IDs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_ID=
RAZORPAY_PLAN_ENTERPRISE_ID=
