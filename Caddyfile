# VaultKey reverse proxy.
# Site address is injected from the VAULTKEY_DOMAIN env var (see .env.example);
# docker-compose passes it into the caddy container.

# Optional: set an ACME account email via ACME_EMAIL in .env by uncommenting:
# {
# 	email {$ACME_EMAIL}
# }

{$VAULTKEY_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 2MB
	}

	# API + health endpoint → Go backend
	reverse_proxy /v1/* vaultkey:8080
	reverse_proxy /healthz vaultkey:8080

	# Everything else (SPA + static assets) → nginx web container
	reverse_proxy web:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://challenges.cloudflare.com; frame-src https://api.razorpay.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; frame-ancestors 'none'"
		-Server
	}
}

# Local development without DNS/TLS requirements:
# comment out the block above and uncomment this one.
#:80 {
